{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "app/Dockerfile",
    "watchPatterns": ["app/**", "pyproject.toml", "uv.lock"]
  },
  "deploy": {
    "startCommand": "python -m podpalto_app.worker",
    "restartPolicyType": "ALWAYS"
  }
}
