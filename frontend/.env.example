# Zkopíruj do .env.local (necommituje se).

# URL backendu FastAPI + CrewAI na Railway, bez koncového lomítka.
# Prázdné = mock režim: aplikace běží 100% na lokálních ukázkových datech ze src/data/.
NEXT_PUBLIC_API_URL=

# Umělá latence mock API v ms (ukáže loading stavy jako u reálného API).
NEXT_PUBLIC_MOCK_LATENCY_MS=150

# Zrychlení simulace CrewAI běhu v CI Studiu (1 = ~30 s, 3 = ~10 s).
NEXT_PUBLIC_MOCK_RUN_SPEED=1

# Mapové dlaždice (výchozí: OpenStreetMap, bez klíče – vhodné pro vývoj a nízký provoz).
# Pro produkci doporučeno vlastní/placené dlaždice, např. https://api.maptiler.com/maps/dataviz/{z}/{x}/{y}.png?key=XXX
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# Volitelně: GeoJSON hranic 14 krajů (vlastnost `kod` = PHA/STC/… nebo `nazev`) pro choropleth.
# Bez něj se „Cenová teplotní mapa krajů“ vykreslí jako plynulá heat mapa celé ČR.
NEXT_PUBLIC_REGIONS_GEOJSON_URL=

# Geokodér pro našeptávač adres nad mapou (výchozí Photon – OpenStreetMap, bez klíče).
# "off" = jen lokální shody (PSČ, okresní města). Pro produkci vlastní instance / komerční API.
NEXT_PUBLIC_GEOCODER_URL=

# Kurz pro přepočet cen na eura (Kč za 1 €), když si uživatel v Nastavení zvolí měnu EUR.
# Prázdné = kurz ČNB z 16. 11. 2026 (24,43). Data a API zůstávají v Kč, přepočítává se jen zobrazení.
NEXT_PUBLIC_EUR_CZK_RATE=

# Veřejná adresa webu – kanonické URL, sitemapa a Open Graph (výchozí https://podpalto.cz).
NEXT_PUBLIC_SITE_URL=

# Supabase – projekt „Podpalto“ (databáze, přihlášení, Storage). Obě hodnoty jsou veřejné, data chrání RLS.
# Vyplněné = data z databáze + povinné přihlášení (kromě blogu). Prázdné = demo režim na src/data/ bez účtů.
NEXT_PUBLIC_SUPABASE_URL=https://sdhinkqouseaaesodqyy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_gJO2G38stzGbitZh69GuXA_tW6xxSIH
