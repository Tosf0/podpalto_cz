# Copy to .env and fill in. Never commit .env.

# LLMs in provider/model format.
# MANAGER_MODEL: the manager of the report crew (delegates, reviews, asks for rework).
# AGENT_MODEL:   every other agent (report specialists, extraction crew).
# MODEL:         fallback for whichever of the two is left empty.
MANAGER_MODEL=anthropic/claude-opus-5-5
AGENT_MODEL=anthropic/claude-sonnet-5-5
MODEL=anthropic/claude-opus-5-5
ANTHROPIC_API_KEY=

# CrewAI execution traces (the app turns them off by default, see app/settings.py).
# CREWAI_TRACING_ENABLED=false

# Where the app finds the tools service. docker compose overrides this with http://tools:8001.
# On Windows prefer 127.0.0.1: "localhost" tries IPv6 first and adds ~2 s to every call.
TOOLS_API_URL=http://127.0.0.1:8001

# Where finished reports and collection summaries are written (relative to the working directory).
OUTPUT_DIR=outputs
# Timeout of one collection step of the CollectionFlow (a Shoptet shop takes minutes).
# COLLECT_TIMEOUT_S=900

# --- tools service: data collection ---
# Snapshot database and raw feed copies (relative to the working directory).
TOOLS_DATA_DIR=data
# Sent with every request to a seller's site. For regular operation use a value that
# lets a shop owner identify and contact you, e.g. "name-of-bot/1.0 (+https://your-site/bot)".
# COLLECTOR_USER_AGENT=
# A source collected more recently than this many seconds is skipped.
# COLLECT_MIN_INTERVAL_S=3600
# OCR of price lists published as images. Defaults: tesseract on PATH (on Windows
# C:\Program Files\Tesseract-OCR\tesseract.exe) and data/ocr/tessdata with ces.traineddata.
# TESSERACT_CMD=
# TESSDATA_DIR=
# Shops read page by page: pause between pages (s) and page limit per shop and run.
# COLLECT_PAGE_DELAY_S=1.5
# COLLECT_MAX_PAGES=150
