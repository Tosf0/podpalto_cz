# Copy to .env and fill in. Never commit .env.

# Default LLM used by every CrewAI agent (provider/model format).
MODEL=anthropic/claude-opus-5-5
ANTHROPIC_API_KEY=

# Optional: search API for the crewai-tools SerperDevTool
# SERPER_API_KEY=

# Competitor analysed by the default flow run
COMPETITOR_URL=https://www.example.com
